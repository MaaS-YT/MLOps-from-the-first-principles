# ── W&B local runs (regenerated by running the notebook) ─────────────
wandb/

# ── Notebook outputs ─────────────────────────────────────────────────
*.csv
*.xlsx
*.joblib
*.pth

# ── Artifact cache ───────────────────────────────────────────────────
artifacts/

# ── Notebook checkpoints ─────────────────────────────────────────────
.ipynb_checkpoints/

# ── Archive (old content, not for the reader) ───────────────────────
_archive/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
