    {
      "type": "text",
      "version": 1,
      "versionNonce": 4001,
      "id": "triune-body",
      "x": 80,
      "y": 690,
      "width": 1540,
      "height": 200,
      "angle": 0,
      "strokeColor": "#0a0a0a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4001,
      "fontSize": 17,
      "fontFamily": 3,
      "text": "Docker    Dockerfile        → image            → container\nDVC       .dvc file         → hash + remote    → checked-out data\nMLflow    script            → run + metrics    → re-run from inputs\nW&B       use/log_artifact  → lineage graph    → navigable pipeline\n\nsame shape, four times.\ndefinition → versioned artifact → reproducible instance.\nlearn it once, recognize it everywhere.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "containerId": null,
      "originalText": "Docker    Dockerfile        → image            → container\nDVC       .dvc file         → hash + remote    → checked-out data\nMLflow    script            → run + metrics    → re-run from inputs\nW&B       use/log_artifact  → lineage graph    → navigable pipeline\n\nsame shape, four times.\ndefinition → versioned artifact → reproducible instance.\nlearn it once, recognize it everywhere.",
      "lineHeight": 1.4
    },

    {
      "type": "text",
      "version": 1,
      "versionNonce": 5000,
      "id": "punchline",
      "x": 80,
      "y": 940,
      "width": 1540,
      "height": 80,
      "angle": 0,
      "strokeColor": "#0a0a0a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
